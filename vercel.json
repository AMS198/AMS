{
  "crons": [
    {
      "path": "/api/auto-index",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/analytics-report",
      "schedule": "30 14 * * *"
    }
  ],
  "headers": [
    {
      "source": "/areas/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/hi/areas/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/mr/areas/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
